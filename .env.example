# Set true when using the included local API or your real backend.
VITE_USE_BACKEND=false
VITE_ALLOWED_SIGNUP_EMAIL_DOMAINS=

# The included local API uses this URL.
VITE_API_BASE_URL=http://localhost:5050/api

# Keep false for presentation; true only shows internal demo controls.
VITE_SHOW_DEMO_CONTROLS=false

# Local development uses JSON storage. Production should use mongodb.
SMARTTRANSIT_STORAGE=json

# MongoDB production values. Leave empty in local JSON mode.
SMARTTRANSIT_MONGODB_URI=
SMARTTRANSIT_MONGODB_DB=smarttransit
SMARTTRANSIT_MONGODB_COLLECTION=app_state

# Real signup OTP email delivery.
# For Gmail, create an App Password from your Google account and use it here.
SMARTTRANSIT_EMAIL_PROVIDER=smtp
SMARTTRANSIT_SMTP_HOST=smtp.gmail.com
SMARTTRANSIT_SMTP_PORT=465
SMARTTRANSIT_SMTP_SECURE=true
SMARTTRANSIT_SMTP_USER=your.sender@gmail.com
SMARTTRANSIT_SMTP_PASS=your-gmail-app-password
SMARTTRANSIT_BREVO_API_KEY=
SMARTTRANSIT_MAIL_FROM="SmartTransit <your.sender@gmail.com>"
SMARTTRANSIT_OTP_SECRET=replace-with-a-long-random-secret
SMARTTRANSIT_ALLOWED_SIGNUP_EMAIL_DOMAINS=
